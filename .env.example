# Tube TLDR reads API keys from environment variables (see README).
# Copy to .env and fill in the ones you use.

# Ollama Cloud (https://ollama.com) — required when llm.provider is "ollama"
# with a cloud base_url. NOT required for a local Ollama server.
OLLAMA_API_KEY=

# OpenAI — required when llm.provider is "openai" (API_KEY also accepted).
OPENAI_API_KEY=
